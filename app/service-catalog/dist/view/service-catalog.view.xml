<mvc:View controllerName="servicecatalog.controller.service-catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}" class="sapUiResponsiveContentPadding">
        <content>

            <Toolbar class="sapUiSmallMarginBottom" id="tb" height="3.75rem" style="Clear">
                <SearchField id="searchField" width="20rem" placeholder="Search"
                    search=".onFilter"/>
                <ToolbarSpacer id="tbs"/>
                <Label text="Service Name:" labelFor="nameFilter" id="lblts"/>
                <Select id="nameFilter" selectedKey="all" autoAdjustWidth="true"
                    forceSelection="false" >
                    <core:Item key="all" text="All" id="citem"/>
                </Select>
                <Label text="Status:" labelFor="statusFilter" id="lst"/>
                <Select id="statusFilter" selectedKey="all" autoAdjustWidth="true">
                    <core:Item key="all" text="All" id="ciall"/>
                    <core:Item key="active" text="Active" id="ciactive"/>
                    <core:Item key="inactive" text="Inactive" id="ciinac"/>
                </Select>
                <Button text="Filter" type="Emphasized" press=".onFilter" id="btnF"/>
                <Button text="Clear" type="Transparent" press=".onClearFilters" id="btnClear"/>
            </Toolbar>

            <Table id="servicesTable" items="{ path: '/Services', parameters: { $$updateGroupId: 'serviceForm' }}">
                <headerToolbar>
                    <OverflowToolbar id="ofTb">
                        <Title id="title" text="Service Catalog" level="H2"/>
                        <ToolbarSpacer id="spacer"/>
                        <Button id="btnAdd" text="Add Service" type="Emphasized" icon="sap-icon://add" press=".onAddService"/>
                        <Button id="btnUpload" text="Upload" icon="sap-icon://upload" press=".onUpload"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="sn"><Text id="tsn" text="Service Name"/></Column>
                    <Column id="pc"><Text id="tpc" text="Plan Coverage"/></Column>
                    <Column id="tfi"><Text id="ttfi" text="Technical Features Inclusion"/></Column>
                    <Column id="cbm"><Text id="tcbm" text="Cost by Metrics"/></Column>
                    <Column id="sapimc"><Text id="tsapimc" text="SAP Indicative Monthly Cost"/></Column>
                    <Column id="status"><Text id="tstatus" text="Status"/></Column>
                    <Column hAlign="Center" width="7rem" id="hA"/>
                </columns>
                <items>
                    <ColumnListItem id="cli">
                        <cells>
                            <Text id="tname" text="{name}"/>
                            <Text id="tplan" text="{plan}"/>
                            <Text id="ttf" text="{techFeature}"/>
                            <Text id="tcbms" text="{costByMetrics}"/>
                            <ObjectNumber id="objNum"
                                number="{
                                    path: 'imc',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 }
                                }"
                                unit="{currency/symbol}"
                            />
                            <ObjectStatus id="objStat"
                                text="{= ${status} ? 'Active' : 'Inactive' }"
                                state="{= ${status} ? 'Success' : 'Error' }"
                                icon="{= ${status} ? 'sap-icon://sys-enter-2' : 'sap-icon://error' }"
                                inverted="true"/>
                            <HBox justifyContent="Center" id="hb">
                                <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press=".onEditService" id="btnIcE"/>
                                <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press=".onDeleteService" id="btnIcD"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>